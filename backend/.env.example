# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SCHEMA=public

# Zilliz
ZILLIZ_URI=
ZILLIZ_TOKEN=

# Redis (local dev creds admin/admin — see compose.yaml; Railway injects its own
# authenticated REDIS_URL in production, no override needed here)
REDIS_URL=redis://admin:admin@localhost:6379

# Ollama
LANGCHAIN_OLLAMA_BASE_URL=http://localhost:11434
LANGCHAIN_OLLAMA_MODEL=llama3.1:8b

# Hugging Face (used when ENVIRONMENT is not "development")
HUGGINGFACEHUB_API_TOKEN=
LANGCHAIN_HUGGINGFACE_MODEL=zai-org/GLM-5.2

# App
SECRET_KEY=
ENVIRONMENT=development
