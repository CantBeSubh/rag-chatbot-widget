# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SCHEMA=public

# Zilliz
ZILLIZ_URI=
ZILLIZ_TOKEN=

# Redis (local dev creds admin/admin — see compose.yaml; Railway injects its own
# authenticated REDIS_URL in production, no override needed here)
REDIS_URL=redis://admin:admin@localhost:6379

# Ollama (final fallback — always available, no API key needed)
LANGCHAIN_OLLAMA_BASE_URL=http://localhost:11434
LANGCHAIN_OLLAMA_MODEL=llama3.1:8b

# Fallback chain (tried in this order before Ollama): NVIDIA -> Groq -> Cerebras -> OpenRouter -> Google AI Studio
# Leave a key blank to skip that provider in the chain.
NVIDIA_API_KEY=
LANGCHAIN_NVIDIA_MODEL=openai/gpt-oss-120b

GROQ_API_KEY=
LANGCHAIN_GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
LANGCHAIN_CEREBRAS_MODEL=gpt-oss-120b

OPENROUTER_API_KEY=
LANGCHAIN_OPENROUTER_MODEL=openai/gpt-oss-20b:free

GOOGLE_API_KEY=
LANGCHAIN_GOOGLE_MODEL=gemini-2.5-flash-lite

# App
SECRET_KEY=
ENVIRONMENT=development
